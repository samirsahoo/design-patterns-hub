    "views": [
      {
        "id": "save",
        "label": "Save and flush",
        "focus": [
          "transient",
          "managed",
          "flushed",
          "committed"
        ],
        "note": "persist makes an entity managed; flush writes SQL; commit makes it durable."
      },
      {
        "id": "detach",
        "label": "Detached entities",
        "focus": [
          "managed",
          "detached"
        ],
        "note": "After the persistence context closes, entities are detached; merge re-attaches a copy."
      },
      {
        "id": "remove",
        "label": "Removal",
        "focus": [
          "managed",
          "removed",
          "deleted"
        ],
        "note": "remove schedules a DELETE that runs at flush."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Managed path"
    },
    {
      "id": "waiting",
      "label": "Detached"
    },
