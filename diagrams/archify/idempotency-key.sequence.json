  "cards": [
    {
      "dot": "emerald",
      "title": "Contract",
      "items": [
        "Client generates one key per logical operation",
        "Same key + same body → same result"
      ]
    },
    {
      "dot": "rose",
      "title": "Concurrency",
      "items": [
        "Unique insert stops two in-flight duplicates",
        "IN_PROGRESS requests get 409 or wait"
      ]
    },
    {
      "dot": "amber",
      "title": "Retention",
      "items": [
        "Keys expire after e.g. 24 h",
        "Different body with same key → 422"
      ]
