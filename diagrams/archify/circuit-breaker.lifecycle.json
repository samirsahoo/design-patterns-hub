      },
      {
        "id": "protect",
        "label": "Protecting",
        "focus": [
          "open",
          "fallback"
        ],
        "note": "While OPEN, calls fail fast and a fallback answers."
      },
      {
        "id": "probe",
        "label": "Recovery",
        "focus": [
          "open",
          "halfopen",
          "trialfail",
          "recovered"
        ],
        "note": "After the wait duration, trial calls decide whether to close or reopen."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Healthy"
    },
    {
      "id": "waiting",
      "label": "Waiting"
    },
    {
      "id": "exceptions",
      "label": "Protecting"
    },
    {
      "id": "terminal",
      "label": "Manual"
    }
  ],
  "states": [
    {
      "id": "closed",
      "type": "start",
      "label": "CLOSED",
      "sublabel": "calls pass",
      "lane": "main",
      "col": 0,
      "step": "01"
    },
    {
      "id": "threshold",
      "type": "decision",
      "label": "Threshold hit?",
      "sublabel": "failure / slow rate",
      "lane": "main",
      "col": 1,
      "step": "02"
    },
    {
      "id": "open",
