      "variant": "security"
    },
    {
      "id": "reopen",
      "from": "trialfail",
      "to": "open",
      "variant": "emphasis"
    },
    {
      "id": "ops",
      "from": "recovered",
      "to": "forced",
      "variant": "dashed"
    }
