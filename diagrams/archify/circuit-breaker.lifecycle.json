      "col": 2,
      "step": "03"
    },
    {
      "id": "halfopen",
      "type": "active",
      "label": "HALF_OPEN",
      "sublabel": "trial calls",
      "lane": "main",
      "col": 3,
      "step": "04"
    },
    {
      "id": "recovered",
      "type": "success",
      "label": "CLOSED again",
      "sublabel": "recovered",
      "lane": "main",
      "col": 4,
      "step": "05"
    },
    {
      "id": "fallback",
      "type": "waiting",
      "label": "Fallback",
      "sublabel": "cache, default",
      "lane": "waiting",
      "col": 0
